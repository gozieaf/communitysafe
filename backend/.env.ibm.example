# IBM Code Engine runtime environment. Store real values in a Code Engine secret/configmap.
DATABASE_URL=postgresql+psycopg://geoapp:CHANGE_ME@AIVEN_HOST:AIVEN_PORT/geodb?sslmode=verify-full
PGSSLROOTCERT=/run/secrets/aiven-ca.pem
JWT_SECRET=generate-a-32-byte-or-longer-secret
CORS_ORIGINS=["https://your-project.us-south.codeengine.appdomain.cloud","https://your-vercel-app.vercel.app"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_MAX_BYTES=52428800
COOKIE_SECURE=true
COOKIE_SAMESITE=none
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=CommunitySafe <mailer@example.com>
PUBLIC_API_URL=https://your-project.us-south.codeengine.appdomain.cloud
PORT=8080
